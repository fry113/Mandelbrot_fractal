{
  "name": "Ubuntu25.04 with GCC15",
  "build": {
      "dockerfile": "./Dockerfile",
      "context": ".",
      "args": {
        "USER_UID": "${localEnv:USER_UID}",
        "USER_GID": "${localEnv:USER_GID}"
      }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "dev",
  "postStartCommand": "conan profile detect || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "twxs.cmake",
        "streetsidesoftware.code-spell-checker-russian",
        "streetsidesoftware.code-spell-checker",
        "matepek.vscode-catch2-test-adapter"
      ]
    }
  },
  "remoteEnv": {
    "DISPLAY": "host.docker.internal:0",
    "XDG_RUNTIME_DIR": "/tmp/runtime-dev"
  },
  "postCreateCommand": "apt-get update && apt-get install -y libxrender1 libxext6 libgl1-mesa-glx",
  "mounts": [
    "source=D:/0_git/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached",
    "source=C:/.conan2,target=/home/dev/.conan2,type=bind,consistency=cached",
    "source=vscode-global-storage,target=/home/dev/.config/Code/User/globalStorage/saoudrizwan.claude-dev,type=volume"

  ],
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ]
}